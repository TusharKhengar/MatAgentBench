# Copy to .env and fill in. Never commit .env -- it is gitignored.
# In CI these same names are read from GitHub Actions Secrets instead.

# --- Ground truth -------------------------------------------------------------
# Free key, no card required: https://next-gen.materialsproject.org/api
# Register -> profile -> API key. Data is CC-BY-4.0.
MP_API_KEY=

# JARVIS-DFT (NIST) needs no key -- it is public domain and fetched over plain HTTP.

# --- Agent inference (all free tiers, all serving open-weight models) ---------
# Pick at least one. The runner reads whichever is set.
# https://console.groq.com/keys
GROQ_API_KEY=
# https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# https://openrouter.ai/keys  (use :free model variants)
OPENROUTER_API_KEY=
# https://huggingface.co/settings/tokens
HF_TOKEN=

# --- Local tier (no key needed) ----------------------------------------------
# Ollama or any OpenAI-compatible local server, e.g. llama.cpp --server
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=qwen3:4b

# --- Runner behaviour ---------------------------------------------------------
MAB_CACHE_DIR=.mab_cache
MAB_MAX_RETRIES=6
